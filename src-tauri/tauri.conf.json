{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lazymidi",
  "version": "0.1.7",
  "identifier": "app.lazymidi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "lazymidi",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "backgroundColor": "#131313"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: converter: http://converter.localhost https://img.youtube.com https://i.ytimg.com; connect-src ipc: http://ipc.localhost 'self' converter: http://converter.localhost; script-src 'self' 'wasm-unsafe-eval'; media-src 'self' blob: converter: http://converter.localhost; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Analog keyboard and MIDI performance utility",
    "copyright": "Copyright 2026 lazymidi contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES",
      "../THIRD_PARTY_DEPENDENCIES.html",
      "../THIRD_PARTY_FRONTEND_NOTICES.txt",
      "../docs/licenses/multi-transpose-LICENSE.txt",
      "../docs/licenses/mp3converter-LICENSE.txt",
      "../converter/app.py",
      "../converter/service.py",
      "../converter/check_environment.py",
      "../converter/persistence.py",
      "../converter/midi_to_sheets.py",
      "../converter/transkun_runner.py",
      "../converter/console_ui.py",
      "../converter/LICENSE",
      "../converter/packs.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
